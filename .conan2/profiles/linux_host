[settings]
os=Linux
arch=x86_64
compiler=gcc
#GNU extensions needed by Qt
compiler.cppstd=gnu20
compiler.version=11
compiler.libcxx=libstdc++11
build_type=Release

[conf]
# Automatically install required system packages
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True

[options]
libxml2/*:iconv=False