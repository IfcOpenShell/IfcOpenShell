{
  "name": "@ifcopenshell/util",
  "version": "0.1.0",
  "description": "IfcOpenShell utility functions, transpiled from ifcopenshell.util",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IfcOpenShell/IfcOpenShell.git",
    "directory": "src/ts/ifcopenshell-util"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "python ../../transpiler/generate.py",
    "build": "tsc && node -e \"require('fs').cpSync('src', 'dist', { recursive: true, filter: f => !f.endsWith('.ts') })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record": "python ../../transpiler/parity/record.py util"
  },
  "peerDependencies": {
    "ifcopenshell": "^0.1.0"
  },
  "devDependencies": {
    "@ifcopenshell/wasm": "file:../ifcopenshell-wasm",
    "ifcopenshell": "file:../ifcopenshell-js",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
