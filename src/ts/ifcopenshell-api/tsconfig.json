{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    // Generated from Python, which does not track None; null checks follow the Python behaviour instead.
    "strict": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "ifcopenshell": ["../ifcopenshell-js/dist/index.d.ts"],
      "@ifcopenshell/util/*": ["../ifcopenshell-util/dist/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
