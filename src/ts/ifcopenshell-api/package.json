{
  "name": "@ifcopenshell/api",
  "version": "0.1.0",
  "description": "IfcOpenShell authoring API, transpiled from ifcopenshell.api",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IfcOpenShell/IfcOpenShell.git",
    "directory": "src/ts/ifcopenshell-api"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "python ../../transpiler/generate.py",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ifcopenshell/util": "^0.1.0",
    "ifcopenshell": "^0.1.0"
  },
  "devDependencies": {
    "@ifcopenshell/util": "file:../ifcopenshell-util",
    "ifcopenshell": "file:../ifcopenshell-js",
    "typescript": "^5.6.0"
  }
}
