{
  "name": "@ifcopenshell-js/web",
  "version": "0.1.0",
  "description": "Ergonomic TypeScript/JavaScript wrappers for IfcOpenShell WASM",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geom": {
      "types": "./dist/geom/index.d.ts",
      "import": "./dist/geom/index.js"
    },
    "./serializers": {
      "types": "./dist/serializers/index.d.ts",
      "import": "./dist/serializers/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ifcopenshell-js/wasm": "^0.1.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.55.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
