<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>PartOf USERDEFINED prohibition</title>
        <description>A wall must not sit in a user-defined-type space.</description>
    </info>
    <specifications>
        <specification name="Walls must not be in a user-defined space" ifcVersion="IFC4">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="prohibited">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                        <predefinedType>
                            <simpleValue>USERDEFINED</simpleValue>
                        </predefinedType>
                    </entity>
                </partOf>
            </requirements>
        </specification>
    </specifications>
</ids>