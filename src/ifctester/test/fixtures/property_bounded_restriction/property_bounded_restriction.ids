<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>Foo must be at least 20</title>
        <description>A bounded property with an open lower bound cannot prove it never dips below the required minimum.</description>
    </info>
    <specifications>
        <specification name="Walls must have Foo of at least 20" ifcVersion="IFC4">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Foo_Bar</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Foo</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction xmlns:xs="http://www.w3.org/2001/XMLSchema" base="xs:double">
                            <xs:minInclusive value="20"/>
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
    </specifications>
</ids>
