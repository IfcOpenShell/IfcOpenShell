diff --git a/CMakeLists.txt b/CMakeLists.txt
index 34300d41ad..efe3065499 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -363,6 +363,10 @@ else()
   set (USE_D3D OFF)
 endif()
 
+# IfcOpenShell begin
+add_definitions(-DHAVE_NO_DLL)
